# CIV token after launch. Leave blank for mock market data.
NEXT_PUBLIC_CIV_MINT=
# The StonkFun quote/reward asset that CIV is paired with.
NEXT_PUBLIC_GOLD_MINT=
NEXT_PUBLIC_GOLD_DECIMALS=6
# Wallet that receives GOLD spent for in-game utility. Leave blank for mock spending.
NEXT_PUBLIC_GAME_TREASURY=
# Use a dedicated production RPC before launch.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Canonical deployed origin, e.g. https://example.com
NEXT_PUBLIC_SITE_URL=
# Optional server override.
STONKFUN_API_BASE=https://www.stonkfun.xyz/api/public/v1
